<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <interface name="org.example.Device">
    <method name="ConnectProfile">
      <arg name="UUID" type="s" direction="in"/>
    </method>
    <method name="SetAddress">
      <arg name="IPAddress" type="s" direction="in"/>
      <arg name="PrefixLength" type="u" direction="in"/>
      <arg name="OldAddress" type="s" direction="out"/>
    </method>
    <signal name="Discovered">
      <arg name="UUID" type="s"/>
      <arg name="RSSI" type="n"/>
    </signal>
  </interface>
</node>
